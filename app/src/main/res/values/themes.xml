<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BarberFlow" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/bf_dourado</item>
        <item name="colorOnPrimary">@color/bf_preto</item>
        <item name="colorPrimaryContainer">@color/bf_dourado_escuro</item>
        <item name="colorOnPrimaryContainer">@color/bf_texto</item>
        <item name="colorSecondary">@color/bf_dourado</item>
        <item name="colorOnSecondary">@color/bf_preto</item>
        <item name="colorSecondaryContainer">@color/bf_superficie_alta</item>
        <item name="colorOnSecondaryContainer">@color/bf_dourado</item>
        <item name="android:colorBackground">@color/bf_fundo</item>
        <item name="colorSurface">@color/bf_fundo</item>
        <item name="colorSurfaceContainer">@color/bf_superficie</item>
        <item name="colorSurfaceContainerLow">@color/bf_superficie</item>
        <item name="colorSurfaceContainerHigh">@color/bf_superficie_alta</item>
        <item name="colorOnSurface">@color/bf_texto</item>
        <item name="colorOnSurfaceVariant">@color/bf_texto_secundario</item>
        <item name="colorOutline">@color/bf_contorno</item>
        <item name="colorError">@color/bf_erro</item>
        <item name="android:windowBackground">@color/bf_fundo</item>
        <item name="android:statusBarColor">@color/bf_fundo</item>
        <item name="android:navigationBarColor">@color/bf_superficie</item>
    </style>

    <style name="BarberFlow.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/bf_dourado</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="BarberFlow.Cartao" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bf_superficie</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="strokeColor">@color/bf_contorno</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
