<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo de um horário: dourado quando selecionado, contorno quando livre -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bf_dourado" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bf_superficie" />
            <stroke android:width="1dp" android:color="@color/bf_contorno" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
