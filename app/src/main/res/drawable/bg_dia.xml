<?xml version="1.0" encoding="utf-8"?>
<!-- Dia do carrossel: dourado quando escolhido; superfície com contorno fino nos outros -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bf_dourado" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bf_superficie_alta" />
            <stroke android:width="1dp" android:color="@color/bf_contorno" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
