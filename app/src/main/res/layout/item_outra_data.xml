<?xml version="1.0" encoding="utf-8"?>
<!-- Último item do carrossel: abre o calendário (DatePickerDialog) para escolher outra data -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="72dp"
    android:layout_height="82dp"
    android:background="@drawable/bg_dia"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="4dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_marcar"
        android:tint="@color/bf_dourado" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:text="@string/marcar_outra_data"
        android:textColor="@color/bf_dourado"
        android:textSize="11sp" />
</LinearLayout>
