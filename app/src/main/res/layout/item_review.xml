<?xml version="1.0" encoding="utf-8"?>
<!-- Uma review do Google: avatar com a inicial, autor, estrelas douradas e o texto -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/BarberFlow.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inicial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pilula_dourada"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/bf_dourado"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/autor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/bf_texto" />

                <RatingBar
                    android:id="@+id/estrelas"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressBackgroundTint="@color/bf_contorno_forte"
                    android:progressTint="@color/bf_dourado" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/bf_texto_secundario" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
