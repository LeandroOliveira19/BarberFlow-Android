<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/foto"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/bf_superficie_alta"
            android:contentDescription="@string/foto_barbeiro"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/nome"
                style="@style/BarberFlow.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tituloEspecialidades"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/detalhe_especialidades"
                android:textColor="@color/bf_texto_secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/especialidades"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bf_dourado"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tituloBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/detalhe_sobre"
                android:textColor="@color/bf_texto_secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/bf_texto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoInstagram"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/detalhe_instagram"
                app:icon="@drawable/ic_link" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoMarcar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                app:icon="@drawable/ic_marcar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
