<?xml version="1.0" encoding="utf-8"?>
<!-- Uma marcação: bloco de data (dia e mês) à esquerda, hora e serviço ao centro, estado em pílula; ações por baixo -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BarberFlow.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/topo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_icone_servico"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:textColor="@color/bf_texto"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/mes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_semibold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/bf_dourado"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quando"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/bf_texto" />

                <TextView
                    android:id="@+id/servicoBarbeiro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/bf_texto_secundario" />
            </LinearLayout>

            <TextView
                android:id="@+id/estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Cancelar/remarcar: só numa marcação confirmada e dentro do prazo da barbearia -->
        <LinearLayout
            android:id="@+id/acoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoCancelar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alterar_cancelar"
                android:textColor="@color/bf_erro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoRemarcar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/alterar_remarcar" />
        </LinearLayout>

        <TextView
            android:id="@+id/avisoAlterar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/alterar_fora_prazo"
            android:textColor="@color/bf_texto_secundario"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Contactar a barbearia: só numa marcação confirmada que ainda não aconteceu -->
        <LinearLayout
            android:id="@+id/contactos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bf_contorno_forte" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/marcacao_contactar"
                android:textColor="@color/bf_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoLigar"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    android:text="@string/inicio_ligar"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_telefone"
                    app:iconPadding="4dp"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoWhatsApp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    android:text="@string/marcacao_whatsapp"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_mensagem"
                    app:iconPadding="4dp"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoMapa"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    android:text="@string/inicio_mapa"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_mapa"
                    app:iconPadding="4dp"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Marcar outra vez: abre o Marcar com o mesmo serviço e barbeiro -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoOutraVez"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:text="@string/marcacao_outra_vez"
            android:visibility="gone"
            app:icon="@drawable/ic_repetir"
            app:iconSize="18dp"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
