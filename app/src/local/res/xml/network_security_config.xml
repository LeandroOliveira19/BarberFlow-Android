<?xml version="1.0" encoding="utf-8"?>
<!-- Só no flavor "local": permite HTTP para o servidor de desenvolvimento.
     10.0.2.2 = localhost do PC visto pelo emulador. Para um telemóvel físico na mesma rede,
     acrescenta aqui o IP do PC (ex.: 192.168.1.50) e muda o BASE_URL do flavor local. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
